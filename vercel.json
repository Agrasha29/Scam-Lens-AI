
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
  "root": "frontend/"
},
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/analyze",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analyze-url",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analyze-image",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
